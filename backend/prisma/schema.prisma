// LOGICONTROL PRO — Prisma Schema
// Las tablas definitivas (empresas, usuarios, vehículos, choferes, vencimientos)
// se crearán en la siguiente etapa del desarrollo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

