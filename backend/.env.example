PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL
# En producción (Render): usar Session Pooler de Supabase
# Formato: postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# La contraseña debe estar URL-encoded si contiene caracteres especiales (@ → %40, etc.)
DATABASE_URL=

# URL del frontend (para CORS)
# En desarrollo: http://localhost:5500
# En producción: URL pública de Netlify (sin barra final)
FRONTEND_URL=http://localhost:5500

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Usar secretos distintos para access y refresh
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Storage — para archivos adjuntos
# SUPABASE_URL: URL del proyecto (ej. https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: service_role key (NO la anon key) — NUNCA exponer al frontend
# SUPABASE_STORAGE_BUCKET: nombre del bucket privado (ej. documents)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
