PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL — formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# JWT — generar secretos con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
